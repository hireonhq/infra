# Copy to .env and fill in. Never commit .env -- it holds real credentials.
#
#   cp .env.example .env && chmod 600 .env

# ---- Database ----------------------------------------------------------------
POSTGRES_USER=hireon
POSTGRES_PASSWORD=            # generate: openssl rand -base64 32
POSTGRES_DB=hireon

# ---- Supabase (auth) ---------------------------------------------------------
# The backend fetches JWKS from <SUPABASE_URL>/auth/v1/.well-known/jwks.json
SUPABASE_URL=https://your-project.supabase.co

# ---- ML service --------------------------------------------------------------
ML_SERVICE_URL=http://ml-services:8080/api
ML_SERVICE_API_KEY=
ML_TIMEOUT_SECONDS=30
GEMINI_API_KEY=

# ---- Object storage (Cloudflare R2, S3-compatible) ---------------------------
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=hireon
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ---- Application -------------------------------------------------------------
FRONTEND_URL=https://hireon.evanhfw.my.id

# ---- Deploy pins -------------------------------------------------------------
# Image tags to deploy. deploy.sh overrides these with --tag.
BACKEND_TAG_PIN=latest
FRONTEND_TAG_PIN=latest
ML_IMAGE=ghcr.io/hireonhq/ml-services:latest

# ---- Backups -----------------------------------------------------------------
BACKUP_RETENTION_DAYS=14

# ---- Caddy -------------------------------------------------------------------
# Only needed if Caddy runs from this repo; otherwise it lives in its own .env.
CF_DNS_API_TOKEN=
